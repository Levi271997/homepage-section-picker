# The keys the two server routes need. Copy to .env.local and fill in.
# Both calls are server-side route handlers, so neither key reaches the browser.

# Reads a client's existing site: POST /api/analyze
OPENAI_API_KEY=sk-proj-...

# Writes the homepage copy: POST /api/generate
DEEPSEEK_API_KEY=sk-...

# Optional. Defaults to deepseek-chat.
# DEEPSEEK_MODEL=deepseek-chat

# Optional. Point the writer at a proxy or a local stub instead of DeepSeek.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
